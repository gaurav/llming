# Copy this file to .env and fill in the values:  cp env.default .env
# .env is gitignored at the repo root, so the real IDs never get committed.

# The Sheet's ID: the long string between /d/ and /edit in the Google Sheets URL.
#   https://docs.google.com/spreadsheets/d/<THIS BIT>/edit#gid=0
GOOGLE_SHEET_ID=

# The gid of the master tab, from the same URL's #gid=... when that tab is selected.
# The first tab of a Sheet is always gid 0.
GOOGLE_SHEET_GID=0
