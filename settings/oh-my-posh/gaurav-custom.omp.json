{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "console_title_template": "{{ .Folder }}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#546E7A",
          "template": "\u256d\u2500"
        },
        {
          "type": "root",
          "style": "plain",
          "background": "#546E7A",
          "foreground": "#FFD54F",
          "template": " \uf0e7 <#26C6DA>\ue0b1</>"
        },
        {
          "type": "path",
          "style": "plain",
          "background": "#546E7A",
          "foreground": "#26C6DA",
          "options": {
            "style": "powerlevel",
            "max_width": 30,
            "home_icon": "~",
            "right_format": "<b>%s</b>"
          },
          "template": " {{ .Path }} "
        },
        {
          "type": "git",
          "style": "plain",
          "background": "#546E7A",
          "foreground": "#D4E157",
          "options": {
            "branch_icon": "\ue0a0 "
          },
          "template": "<#26C6DA>\ue0b1</> {{ .HEAD }}{{ if gt .Behind 0 }} \u21e3{{ .Behind }}{{ end }}{{ if gt .Ahead 0 }} \u21e1{{ .Ahead }}{{ end }}{{ if gt .StashCount 0 }} *{{ .StashCount }}{{ end }}{{ if .Staging.Changed }} <#FFD54F>+{{ add .Staging.Added .Staging.Modified .Staging.Deleted .Staging.Moved }}</>{{ end }}{{ if .Working.Changed }}{{ if gt (add .Working.Modified .Working.Deleted) 0 }} <#FFD54F>!{{ add .Working.Modified .Working.Deleted }}</>{{ end }}{{ if gt .Working.Untracked 0 }} <#81D4FA>?{{ .Working.Untracked }}</>{{ end }}{{ end }} "
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "#546E7A",
          "template": "\ue0b0"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "filler": "<#546E7A>\u00b7</>",
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#546E7A",
          "template": "\ue0b2"
        },
        {
          "type": "executiontime",
          "style": "plain",
          "background": "#546E7A",
          "foreground": "#B0BEC5",
          "foreground_templates": [
            "{{ if ge .Ms 3000 }}#FFD54F{{ end }}"
          ],
          "options": {
            "threshold": 0,
            "always_enabled": true,
            "style": "austin"
          },
          "template": " {{ if ge .Ms 3000 }}took {{ .FormattedMs }}, finished {{ now | date \"3:04:05pm\" }}{{ else }}{{ .FormattedMs }}{{ end }} \uf252 "
        },
        {
          "type": "status",
          "style": "plain",
          "background": "#546E7A",
          "foreground": "#FF5252",
          "template": "<#26C6DA>\ue0b3</> \u2718 {{ .Code }} "
        },
        {
          "type": "python",
          "style": "plain",
          "background": "#546E7A",
          "foreground": "#FFE873",
          "options": {
            "display_mode": "files",
            "fetch_virtual_env": false
          },
          "template": "<#26C6DA>\ue0b3</> \ue73c {{ .Full }} "
        },
        {
          "type": "node",
          "style": "plain",
          "background": "#546E7A",
          "foreground": "#8CC84B",
          "options": {
            "display_mode": "files"
          },
          "template": "<#26C6DA>\ue0b3</> \ue718 {{ .Full }} "
        },
        {
          "type": "java",
          "style": "plain",
          "background": "#546E7A",
          "foreground": "#F89820",
          "options": {
            "display_mode": "files"
          },
          "template": "<#26C6DA>\ue0b3</> \ue738 {{ .Full }} "
        },
        {
          "type": "session",
          "style": "plain",
          "background": "#546E7A",
          "foreground": "#D4E157",
          "template": "{{ if or .SSHSession .Root }}<#26C6DA>\ue0b3</> {{ .UserName }}@{{ .HostName }} {{ end }}"
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "#546E7A",
          "template": "\u2500\u256e"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#546E7A",
          "template": "\u2570\u2500"
        },
        {
          "type": "status",
          "style": "plain",
          "foreground": "#D4E157",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#FF5252{{ end }}"
          ],
          "options": {
            "always_enabled": true
          },
          "template": " \u25b8"
        }
      ]
    }
  ],
  "transient_prompt": {
    "foreground": "#D4E157",
    "foreground_templates": [
      "{{ if gt .Code 0 }}#FF5252{{ end }}"
    ],
    "template": "\u25b8 "
  }
}
