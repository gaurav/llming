{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "enable_cursor_positioning": true,
  "console_title_template": "{{ .Folder }}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#546E7A",
          "template": "\u256d\u2500"
        },
        {
          "type": "root",
          "style": "plain",
          "background": "#263238",
          "foreground": "#FFD54F",
          "template": " \uf0e7 <#90A4AE>\u203a</>"
        },
        {
          "type": "path",
          "style": "plain",
          "background": "#263238",
          "foreground": "#A5ECF5",
          "options": {
            "style": "powerlevel",
            "max_width": 30,
            "home_icon": "~",
            "right_format": "<b><#FFFFFF>%s</></b>"
          },
          "template": " {{ .Path }} "
        },
        {
          "type": "git",
          "style": "plain",
          "background": "#263238",
          "foreground": "#AED581",
          "options": {
            "branch_icon": "\ue0a0 "
          },
          "template": "<#90A4AE>\u203a</> {{ .HEAD }}{{ if gt .Behind 0 }} \u21e3{{ .Behind }}{{ end }}{{ if gt .Ahead 0 }} \u21e1{{ .Ahead }}{{ end }}{{ if gt .StashCount 0 }} *{{ .StashCount }}{{ end }}{{ if .Staging.Changed }} <#AED581>+{{ add .Staging.Added .Staging.Modified .Staging.Deleted .Staging.Moved }}</>{{ end }}{{ if .Working.Changed }}{{ if gt (add .Working.Modified .Working.Deleted) 0 }} <#FFD54F>!{{ add .Working.Modified .Working.Deleted }}</>{{ end }}{{ if gt .Working.Untracked 0 }} <#B3E5FC>?{{ .Working.Untracked }}</>{{ end }}{{ end }} ",
          "foreground_templates": [
            "{{ if or .Working.Changed .Staging.Changed }}#FFD54F{{ end }}"
          ]
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "#263238",
          "template": "\ue0b0"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "filler": "<#546E7A>\u00b7</>",
      "overflow": "hide",
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#263238",
          "template": "\ue0b2"
        },
        {
          "type": "executiontime",
          "style": "plain",
          "background": "#263238",
          "foreground": "#E1BEE7",
          "foreground_templates": [
            "{{ if ge .Ms 3000 }}#FFD54F{{ end }}"
          ],
          "options": {
            "threshold": 0,
            "always_enabled": true,
            "style": "austin"
          },
          "template": " {{ if ge .Ms 3000 }}took {{ .FormattedMs }}, finished {{ now | date \"3:04:05pm\" }}{{ else }}{{ .FormattedMs }}{{ end }} \uf252 "
        },
        {
          "type": "status",
          "style": "plain",
          "background": "#263238",
          "foreground": "#FF8A80",
          "template": "<#90A4AE>\u2039</> \u2718 {{ .Code }} "
        },
        {
          "type": "python",
          "style": "plain",
          "background": "#263238",
          "foreground": "#FFE873",
          "options": {
            "display_mode": "files",
            "fetch_virtual_env": false
          },
          "template": "<#90A4AE>\u2039</> \ue73c {{ .Full }} "
        },
        {
          "type": "node",
          "style": "plain",
          "background": "#263238",
          "foreground": "#9CCC65",
          "options": {
            "display_mode": "files"
          },
          "template": "<#90A4AE>\u2039</> \ue718 {{ .Full }} "
        },
        {
          "type": "java",
          "style": "plain",
          "background": "#263238",
          "foreground": "#FFB74D",
          "options": {
            "display_mode": "files"
          },
          "template": "<#90A4AE>\u2039</> \ue738 {{ .Full }} "
        },
        {
          "type": "session",
          "style": "plain",
          "background": "#263238",
          "foreground": "#FFFFFF",
          "template": "{{ if or .SSHSession .Root }}<#90A4AE>\u2039</> {{ .UserName }}@{{ .HostName }} {{ end }}"
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "#546E7A",
          "template": "\u2500\u256e"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#546E7A",
          "template": "\u2570\u2500"
        },
        {
          "type": "status",
          "style": "plain",
          "foreground": "#FFA726",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#FF5252{{ end }}"
          ],
          "options": {
            "always_enabled": true
          },
          "template": " \u25b6"
        }
      ]
    }
  ],
  "transient_prompt": {
    "foreground": "#86A86E",
    "foreground_templates": [
      "{{ if gt .Code 0 }}#E57373{{ end }}"
    ],
    "template": "\u25b6 "
  }
}
